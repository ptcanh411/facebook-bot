# Port cho Express server
PORT=3000

# Token tự đặt, dùng để Facebook verify webhook
VERIFY_TOKEN=my_secret_verify_token

# Page Access Token từ Facebook Developer Console
PAGE_ACCESS_TOKEN=EAAxxxxxxx

# (Optional) App Secret để verify request signature
APP_SECRET=

# Google Gemini API Key để bot trò chuyện thông minh
GEMINI_API_KEY=your_gemini_api_key_here
